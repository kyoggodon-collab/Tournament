{
  "name": "softball-tournament",
  "version": "1.0.0",
  "private": true,
  "description": "研究室対抗ソフトボール大会トーナメント表",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=3001 tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts --host 0.0.0.0",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --import tsx server/index.ts",
    "test": "tsx --test tests/bracket.test.ts tests/resolve.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
